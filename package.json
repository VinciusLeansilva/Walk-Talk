{
  "name": "walk-talk-enterprise",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import ./scripts/sites-env.mjs ./node_modules/vinext/dist/cli.js dev --port 5173",
    "build": "tsc --noEmit && vinext build",
    "lint": "oxlint",
    "preview": "node scripts/preview.mjs",
    "test": "playwright test",
    "start": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:local": "node scripts/migrate-local.mjs",
    "test:api": "node --experimental-transform-types --test server/api.test.ts",
    "test:all": "npm run test:api && npm test"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "framer-motion": "^14.7.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.63.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.186.1",
    "zustand": "^5.0.16",
    "react-server-dom-webpack": "19.2.6",
    "next": "16.3.4",
    "drizzle-orm": "0.45.2",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "lighthouse": "^13.6.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "wrangler": "4.92.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
